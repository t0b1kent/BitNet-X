+// ---------------------------------------------------------------------------------------------------------------------
+// BitNet I2_S, prefill (> 8 columns): the stock simdgroup-matrix kernel_mul_mm with an I2_S dequantizer.
+// A weight block is 128 weights = 32 bytes, i.e. 8 chunks of 16 (nl = 8): chunk il covers the weights
+// [32*(il/2) + 16*(il%2), +16) which are the bytes [16*(il%2), +16) shifted by 6 - 2*(il/2).
+// The activations are quantized beforehand into exact small integers stored as f32 (kernel_quantize_i8_s_f32f_f32),
+// the products and sums of {-1,0,+1} x int8 are exact in the half / f32 matrix multiply, and
+// kernel_i2_s_scale_cols applies  ws / s  per column afterwards (same value as the other paths).
+// ---------------------------------------------------------------------------------------------------------------------
+// BEGIN_BITNETX_MM_I2S
+
+typedef struct {
+    uchar qs[32];
+} block_i2s;
+
+template <typename type4x4>
+void dequantize_i2_s(device const block_i2s * xb, short il, thread type4x4 & reg) {
+    const short sh = 6 - 2*(il/2);
+    const short b0 = 16*(il%2);
+
+    for (short i = 0; i < 16; ++i) {
+        reg[i/4][i%4] = (int) ((xb->qs[b0 + i] >> sh) & 3) - 1;
+    }
+}
+
+template [[host_name("kernel_mul_mm_i2_s_f32")]] kernel mul_mm_t kernel_mul_mm<half, half4x4, simdgroup_half8x8, half, half2x4, simdgroup_half8x8, block_i2s, 8, dequantize_i2_s, float, float4x4, float, float2x4>;
+
+// like kernel_quantize_i8_s_f32 but the quantized values are written as f32
+kernel void kernel_quantize_i8_s_f32f_f32(
+        constant ggml_metal_kargs_quantize_i8_s & args,
+        device const char  * src1,
+        device       float * qf,
+        device       float * scales,
+        uint   col   [[threadgroup_position_in_grid]],
+        ushort tpitg [[thread_index_in_threadgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort tiisg [[thread_index_in_simdgroup]]) {
+    threadgroup float sh[8];
+
+    const int i13 = col / (args.ne11*args.ne12);
+    const int rem = col % (args.ne11*args.ne12);
+    const int i12 = rem / args.ne11;
+    const int i11 = rem % args.ne11;
+
+    device const float * x = (device const float *)(src1 + i13*args.nb13 + i12*args.nb12 + i11*args.nb11);
+
+    float amax = 0.0f;
+    for (int i = tpitg; i < args.ne10; i += 256) {
+        amax = max(amax, fabs(x[i]));
+    }
+    amax = simd_max(amax);
+    if (tiisg == 0) {
+        sh[sgitg] = amax;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    amax = simd_max(tiisg < 8 ? sh[tiisg] : 0.0f);
+
+    const float s = amax > 0.0f ? precise::divide(127.0f, amax) : 0.0f;
+
+    device float * dst = qf + (long) col * args.ne10;
+    for (int i = tpitg; i < args.ne10; i += 256) {
+        dst[i] = (float) clamp((int) round(x[i]*s), -128, 127);
+    }
+
+    if (tpitg == 0) {
+        scales[col] = s;
+    }
+}
+
+// dst[col][row] (contiguous, raw integer sums from the matrix multiply) *= ws / s[col]
+kernel void kernel_i2_s_scale_cols(
+        constant ggml_metal_kargs_mul_mv_i2_s & args,
+        device const char  * src0,
+        device const float * scales,
+        device       float * dst,
+        uint2 gid [[thread_position_in_grid]]) {
+    const int row = gid.x;
+    const int col = gid.y;
+
+    if (row >= args.ne01 || col >= args.ncols) {
+        return;
+    }
+
+    const float ws = *(device const float *)(src0 + args.ws_off);
+    const float s  = scales[col];
+
+    dst[(long) col*args.ne01 + row] = s > 0.0f ? dst[(long) col*args.ne01 + row] * precise::divide(ws, s) : 0.0f;
+}
+// END_BITNETX_MM_I2S
