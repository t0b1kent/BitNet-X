+// C = columns processed together, R = src0 rows per simdgroup
+template<short C, short R>
+kernel void kernel_mul_mv_i2_s_bits(
+        constant ggml_metal_kargs_mul_mv_i2_s & args,
+        device const uint  * wbits,  // repacked weights: [row][ne00/32][2] = {P, N}
+        device const char  * src0,   // original tensor (only the f32 scale at ws_off is read)
+        device const uint  * planes,
+        device const float * scales,
+        device       char  * dst,
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    const int ng = args.ne00/32;
+    const int r0 = (tgpig.x*I2S_NSG + sgitg)*R;
+    const int c0 = tgpig.y*C;
+
+    device const uint * wrow[R];
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        wrow[r] = wbits + (long) min(r0 + r, args.ne01 - 1)*ng*2;
+    }
+
+    device const uint * ycol[C];
+    FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+        ycol[cc] = planes + (long) min(c0 + cc, args.ncols - 1)*ng*8;
+    }
+
+    int acc[R][C];
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+            acc[r][cc] = 0;
+        }
+    }
+
+    for (int t = tiisg; t < ng; t += 32) {
+        uint4 y[C][2];
+        FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+            y[cc][0] = *(device const uint4 *)(ycol[cc] + t*8);
+            y[cc][1] = *(device const uint4 *)(ycol[cc] + t*8 + 4);
+        }
+
+        FOR_UNROLL (short r = 0; r < R; ++r) {
+            const uint2 pn = *(device const uint2 *)(wrow[r] + t*2);
+
+            FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+                int a = 0;
+                a += (int) popcount(pn.x & y[cc][0].x) - (int) popcount(pn.y & y[cc][0].x);
+                a += ((int) popcount(pn.x & y[cc][0].y) - (int) popcount(pn.y & y[cc][0].y)) * 2;
+                a += ((int) popcount(pn.x & y[cc][0].z) - (int) popcount(pn.y & y[cc][0].z)) * 4;
+                a += ((int) popcount(pn.x & y[cc][0].w) - (int) popcount(pn.y & y[cc][0].w)) * 8;
+                a += ((int) popcount(pn.x & y[cc][1].x) - (int) popcount(pn.y & y[cc][1].x)) * 16;
+                a += ((int) popcount(pn.x & y[cc][1].y) - (int) popcount(pn.y & y[cc][1].y)) * 32;
+                a += ((int) popcount(pn.x & y[cc][1].z) - (int) popcount(pn.y & y[cc][1].z)) * 64;
+                a -= ((int) popcount(pn.x & y[cc][1].w) - (int) popcount(pn.y & y[cc][1].w)) * 128;
+                acc[r][cc] += a;
+            }
+        }
+    }
+
+    const float ws = *(device const float *)(src0 + args.ws_off);
+
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+            const int sum = simd_sum(acc[r][cc]);
+
+            const int col = c0 + cc;
+            const int row = r0 + r;
+            if (tiisg == 0 && col < args.ncols && row < args.ne01) {
+                const int   i13 = col / (args.ne11*args.ne12);
+                const int   rem = col % (args.ne11*args.ne12);
+                const int   i12 = rem / args.ne11;
+                const int   i11 = rem % args.ne11;
+                const float s   = scales[col];
+
+                *(device float *)(dst + i13*args.nb3 + i12*args.nb2 + i11*args.nb1 + row*sizeof(float)) =
+                    s > 0.0f ? (float) sum * precise::divide(ws, s) : 0.0f;
+            }
+        }
+    }
+}
