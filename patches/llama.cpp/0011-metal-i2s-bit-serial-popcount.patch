+// BitNet I2_S, Metal: bit-serial ("popcount") weight layout.
+//
+// The canonical I2_S layout stores 4 two-bit codes per byte (128 weights per 32 bytes, byte gp of a block holds the
+// weights {gp, 32+gp, 64+gp, 96+gp}). The bit-serial mat-vec kernel wants, for every group of 32 consecutive weights,
+// two 32-bit masks instead: P (bit i set <=> weight i is +1, code 2) and N (bit i set <=> weight i is -1, code 0).
+// Groups are numbered t = block*4 + g (g = which 32-weight quarter of the block), so group t covers the weights
+// [32*t, 32*t + 32) of the row. A row of K weights becomes (K/32) pairs {P, N}, i.e. K/4 bytes - the same size.
+// Code 1 (zero) and the invalid code 3 set neither mask (weight 0).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <thread>
+#include <vector>
+
+static inline void ggml_metal_i2s_repack_rows(const uint8_t * src, int64_t row_begin, int64_t row_end, int64_t K, uint32_t * dst) {
+    const int64_t nblk = K/128;
+    const int64_t ng   = K/32;
+    for (int64_t row = row_begin; row < row_end; ++row) {
+        const uint8_t * xr = src + row*(K/4);
+        uint32_t      * dr = dst + row*ng*2;
+        for (int64_t b = 0; b < nblk; ++b) {
+            const uint8_t * xb = xr + b*32;
+            for (int g = 0; g < 4; ++g) {
+                const int sh = 6 - 2*g;
+                uint32_t p = 0, n = 0;
+                for (int gp = 0; gp < 32; ++gp) {
+                    const uint32_t f = (xb[gp] >> sh) & 3;
+                    p |= (uint32_t)(f == 2) << gp;
+                    n |= (uint32_t)(f == 0) << gp;
+                }
+                dr[(b*4 + g)*2 + 0] = p;
+                dr[(b*4 + g)*2 + 1] = n;
+            }
+        }
+    }
+}
+
+// src: nrows x K canonical I2_S weights (K % 128 == 0), dst: nrows * K/4 bytes
+static inline void ggml_metal_i2s_repack(const uint8_t * src, int64_t nrows, int64_t K, uint32_t * dst, int nthreads = 0) {
+    if (nthreads <= 0) {
+        nthreads = (int) std::thread::hardware_concurrency();
+        if (nthreads <= 0) nthreads = 4;
+    }
+    if (nrows < 64 || nthreads == 1) {
+        ggml_metal_i2s_repack_rows(src, 0, nrows, K, dst);
+        return;
+    }
+    std::vector<std::thread> th;
+    const int64_t chunk = (nrows + nthreads - 1)/nthreads;
+    for (int i = 0; i < nthreads; ++i) {
+        const int64_t b = i*chunk, e = std::min<int64_t>(nrows, b + chunk);
+        if (b >= e) break;
+        th.emplace_back([=] { ggml_metal_i2s_repack_rows(src, b, e, K, dst); });
+    }
+    for (auto & t : th) t.join();
+}
