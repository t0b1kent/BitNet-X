+// ---------------------------------------------------------------------------------------------------------------------
+// Bit-serial variant (see ggml-metal-i2s.h for the weight layout). The int8 activations of a column are cut into groups
+// of 32 and stored as 8 bit planes (plane p = bit p of the two's complement value of every activation of the group):
+// then   sum_i w_i*v_i = sum_p 2^p * c_p * (popcount(P & plane_p) - popcount(N & plane_p)),  c_7 = -1, else +1,
+// i.e. about 1.5 integer instructions per weight instead of ~5.
+// ---------------------------------------------------------------------------------------------------------------------
+
+// one threadgroup (256 threads) per column; the quantized values stay in threadgroup memory (ne10 bytes)
+kernel void kernel_quantize_i8_s_planes_f32(
+        constant ggml_metal_kargs_quantize_i8_s & args,
+        device const char  * src1,
+        device       uint  * planes, // [col][ne10/32][8]
+        device       float * scales,
+        threadgroup  char  * tv [[threadgroup(0)]],
+        uint   col   [[threadgroup_position_in_grid]],
+        ushort tpitg [[thread_index_in_threadgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort tiisg [[thread_index_in_simdgroup]]) {
+    threadgroup float sh[8];
+
+    const int i13 = col / (args.ne11*args.ne12);
+    const int rem = col % (args.ne11*args.ne12);
+    const int i12 = rem / args.ne11;
+    const int i11 = rem % args.ne11;
+
+    device const float * x = (device const float *)(src1 + i13*args.nb13 + i12*args.nb12 + i11*args.nb11);
+
+    float amax = 0.0f;
+    for (int i = tpitg; i < args.ne10; i += 256) {
+        amax = max(amax, fabs(x[i]));
+    }
+    amax = simd_max(amax);
+    if (tiisg == 0) {
+        sh[sgitg] = amax;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    amax = simd_max(tiisg < 8 ? sh[tiisg] : 0.0f);
+
+    const float s = amax > 0.0f ? precise::divide(127.0f, amax) : 0.0f;
+
+    for (int i = tpitg; i < args.ne10; i += 256) {
+        tv[i] = (char) clamp((int) round(x[i]*s), -128, 127);
+    }
+
+    if (tpitg == 0) {
+        scales[col] = s;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // simdgroup sgitg handles groups sgitg, sgitg+8, ... ; lane i owns activation i of the group
+    device uint * pc = planes + (long) col*(args.ne10/32)*8;
+    for (int t = sgitg; t < args.ne10/32; t += 8) {
+        const uint u = (uint)(uchar) tv[t*32 + tiisg];
+        uint word = 0;
+        FOR_UNROLL (short p = 0; p < 8; ++p) {
+            const uint m = (uint) static_cast<simd_vote::vote_t>(simd_ballot(((u >> p) & 1u) != 0));
+            word = tiisg == p ? m : word;
+        }
+        if (tiisg < 8) {
+            pc[t*8 + tiisg] = word;
+        }
+    }
+}
