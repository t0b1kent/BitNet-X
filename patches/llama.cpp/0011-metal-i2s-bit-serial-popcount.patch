+// Bit-serial layout of an I2_S weight tensor (see ggml-metal-i2s.h), built once on first use and kept until the device is
+// freed (unified memory: one extra copy of the packed weights). Only for weights the CPU can read (shared buffers).
+// Disable with GGML_METAL_I2S_NO_BITS=1. The entry is validated with a small hash of the source bytes so that a tensor
+// that was freed and re-allocated at the same address (another model) is rebuilt.
+struct ggml_metal_i2_s_bits_entry {
+    ggml_metal_buffer_t  buf;
+    ggml_metal_buffer_id bid;
+    uint64_t             hash;
+    int64_t              ne00, ne01;
+};
+
+static uint64_t ggml_metal_i2_s_hash(const uint8_t * p, size_t n) {
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; ++i) { h = (h ^ p[i]) * 1099511628211ull; }
+    return h;
+}
+
+static std::mutex & ggml_metal_i2_s_bits_mutex() {
+    static std::mutex * m = new std::mutex(); // never destroyed: ggml_metal_i2_s_bits_free_all() runs during exit()
+    return *m;
+}
+
+static std::unordered_map<const void *, ggml_metal_i2_s_bits_entry> & ggml_metal_i2_s_bits_cache() {
+    static auto * c = new std::unordered_map<const void *, ggml_metal_i2_s_bits_entry>();
+    return *c;
+}
+
+void ggml_metal_i2_s_bits_free_all(void) {
+    std::lock_guard<std::mutex> lock(ggml_metal_i2_s_bits_mutex());
+    auto & cache = ggml_metal_i2_s_bits_cache();
+    for (auto & kv : cache) {
+        ggml_metal_buffer_free(kv.second.buf);
+    }
+    cache.clear();
 }
 
+static bool ggml_metal_i2_s_get_bits(ggml_metal_device_t dev, const ggml_tensor * w, ggml_metal_buffer_id * out) {
+    static const bool disabled = getenv("GGML_METAL_I2S_NO_BITS") != nullptr;
+    if (disabled) {
+        return false;
+    }
+
+    ggml_backend_buffer_t wbuf = w->view_src ? w->view_src->buffer : w->buffer;
+    if (!wbuf || !ggml_metal_buffer_is_shared((ggml_metal_buffer_t) wbuf->context)) {
+        return false;
+    }
+
+    const int64_t K = w->ne[0], N = w->ne[1];
+    const size_t  nbytes = (size_t) (K/4)*N;
+    const uint8_t * src = (const uint8_t *) w->data;
+
+    // hash of the first and last 2 KB of the packed data (cheap, called for every mat-mul)
+    const size_t nh = nbytes < 2048 ? nbytes : 2048;
+    const uint64_t h = ggml_metal_i2_s_hash(src, nh) ^ (ggml_metal_i2_s_hash(src + nbytes - nh, nh) << 1);
+
+    std::lock_guard<std::mutex> lock(ggml_metal_i2_s_bits_mutex());
+    auto & cache = ggml_metal_i2_s_bits_cache();
+
+    auto it = cache.find(w->data);
+    if (it != cache.end() && it->second.hash == h && it->second.ne00 == K && it->second.ne01 == N) {
+        *out = it->second.bid;
+        return true;
+    }
+    if (it != cache.end()) {
+        ggml_metal_buffer_free(it->second.buf);
+        cache.erase(it);
+    }
+
+    ggml_metal_buffer_t buf = ggml_metal_buffer_init(dev, nbytes, true);
+    if (!buf) {
+        return false;
+    }
+
+    ggml_metal_i2s_repack(src, N, K, (uint32_t *) ggml_metal_buffer_get_base(buf));
+
+    // a byte tensor spanning the whole buffer gives us the MTLBuffer + offset
+    ggml_tensor fake;
+    memset(&fake, 0, sizeof(fake));
+    fake.type  = GGML_TYPE_I8;
+    fake.ne[0] = (int64_t) nbytes; fake.ne[1] = fake.ne[2] = fake.ne[3] = 1;
+    fake.nb[0] = 1; fake.nb[1] = fake.nb[2] = fake.nb[3] = nbytes;
+    fake.data  = ggml_metal_buffer_get_base(buf);
+
+    ggml_metal_i2_s_bits_entry e = { buf, ggml_metal_buffer_get_id(buf, &fake), h, K, N };
+    cache[w->data] = e;
+    *out = e.bid;
+    return true;
+}
