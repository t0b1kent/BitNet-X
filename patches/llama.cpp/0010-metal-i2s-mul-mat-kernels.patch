+// BEGIN_BITNETX_I2S (extracted verbatim by tests/metal/run.sh)
+// ---------------------------------------------------------------------------------------------------------------------
+// BitNet I2_S x f32 (see ggml_metal_kargs_quantize_i8_s)
+// Weight layout (canonical, same as the official GGUF and dequantize_row_i2_s): 128 weights per 32 bytes, byte gp of a
+// block holds the codes of weights {gp, 32+gp, 64+gp, 96+gp} in bits [7:6], [5:4], [3:2], [1:0]; code 0/1/2 = -1/0/+1.
+// ---------------------------------------------------------------------------------------------------------------------
+
+#ifndef I2S_NSG
+#define I2S_NSG N_SG_I2_S // simdgroups per threadgroup in the mat-vec kernel
+#endif
+#ifndef I2S_R
+#define I2S_R   N_R0_I2_S // src0 rows per simdgroup
+#endif
+
+kernel void kernel_quantize_i8_s_f32(
+        constant ggml_metal_kargs_quantize_i8_s & args,
+        device const char  * src1,
+        device       char  * q8,
+        device       float * scales,
+        uint   col   [[threadgroup_position_in_grid]],
+        ushort tpitg [[thread_index_in_threadgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort tiisg [[thread_index_in_simdgroup]]) {
+    threadgroup float sh[8];
+
+    const int i13 = col / (args.ne11*args.ne12);
+    const int rem = col % (args.ne11*args.ne12);
+    const int i12 = rem / args.ne11;
+    const int i11 = rem % args.ne11;
+
+    device const float * x = (device const float *)(src1 + i13*args.nb13 + i12*args.nb12 + i11*args.nb11);
+
+    float amax = 0.0f;
+    for (int i = tpitg; i < args.ne10; i += 256) {
+        amax = max(amax, fabs(x[i]));
+    }
+    amax = simd_max(amax);
+    if (tiisg == 0) {
+        sh[sgitg] = amax;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    amax = simd_max(tiisg < 8 ? sh[tiisg] : 0.0f);
+
+    const float s = amax > 0.0f ? precise::divide(127.0f, amax) : 0.0f;
+
+    device char * dst = q8 + (long) col * args.ne10;
+    for (int i = tpitg; i < args.ne10; i += 256) {
+        int v = (int) round(x[i]*s);
+        dst[i] = (char) clamp(v, -128, 127);
+    }
+
+    if (tpitg == 0) {
+        scales[col] = s;
+    }
+}
+
+// C = number of src1 columns processed together (the packed weights are decoded once for all of them).
+// No threadgroup memory / barrier: the int8 activations are read straight from device memory (they are shared by every
+// threadgroup and stay in the caches); every lane owns 8 of the 32 bytes of a weight block, i.e. 32 weights.
+template<short C>
+kernel void kernel_mul_mv_i2_s_i8(
+        constant ggml_metal_kargs_mul_mv_i2_s & args,
+        device const char  * src0,
+        device const char  * q8,
+        device const float * scales,
+        device       char  * dst,
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    const int K  = args.ne00;
+    const int r0 = (tgpig.x*I2S_NSG + sgitg)*I2S_R;
+    const int c0 = tgpig.y*C;
+
+    const int   nb = K/128;
+    const short bl = tiisg/4; // block handled by this lane (8 blocks per iteration)
+    const short p  = tiisg%4; // which 8 of the 32 bytes of a block
+
+    device const char * wrow[I2S_R];
+    FOR_UNROLL (short r = 0; r < I2S_R; ++r) {
+        wrow[r] = src0 + (long) min(r0 + r, args.ne01 - 1)*(K/4) + p*8;
+    }
+
+    device const char * ycol[C];
+    FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+        ycol[cc] = q8 + (long) min(c0 + cc, args.ncols - 1)*K + p*8;
+    }
+
+    int acc[I2S_R][C];
+    FOR_UNROLL (short r = 0; r < I2S_R; ++r) {
+        FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+            acc[r][cc] = 0;
+        }
+    }
+
+    for (int b = bl; b < nb; b += 8) {
+        // activations of this lane: 4 groups (g*32) x 8 consecutive values, for every column
+        int4 y[C][4][2];
+        FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+            device const packed_char4 * yp = (device const packed_char4 *)(ycol[cc] + b*128);
+            FOR_UNROLL (short g = 0; g < 4; ++g) {
+                y[cc][g][0] = int4(yp[g*8 + 0]);
+                y[cc][g][1] = int4(yp[g*8 + 1]);
+            }
+        }
+
+        FOR_UNROLL (short r = 0; r < I2S_R; ++r) {
+            const uint2 wv = *(device const uint2 *)(wrow[r] + b*32);
+
+            FOR_UNROLL (short h = 0; h < 2; ++h) {
+                const uchar4 x = as_type<uchar4>(wv[h]); // bytes 4h..4h+3
+
+                const int4 w0 = int4((x >> 6) & 3) - 1;
+                const int4 w1 = int4((x >> 4) & 3) - 1;
+                const int4 w2 = int4((x >> 2) & 3) - 1;
+                const int4 w3 = int4( x       & 3) - 1;
+
+                FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+                    const int4 m = w0*y[cc][0][h] + w1*y[cc][1][h] + w2*y[cc][2][h] + w3*y[cc][3][h];
+
+                    acc[r][cc] += m.x + m.y + m.z + m.w;
+                }
+            }
+        }
+    }
+
+    const float ws = *(device const float *)(src0 + args.ws_off);
+
+    FOR_UNROLL (short r = 0; r < I2S_R; ++r) {
+        FOR_UNROLL (short cc = 0; cc < C; ++cc) {
+            const int sum = simd_sum(acc[r][cc]);
+
+            const int col = c0 + cc;
+            const int row = r0 + r;
+            if (tiisg == 0 && col < args.ncols && row < args.ne01) {
+                const int   i13 = col / (args.ne11*args.ne12);
+                const int   rem = col % (args.ne11*args.ne12);
+                const int   i12 = rem / args.ne11;
+                const int   i11 = rem % args.ne11;
+                const float s   = scales[col];
+
+                // an all-zero column quantizes with s == 0; its result is exactly 0.
+                // (the compiler may evaluate this as (sum*ws)*(1/s): results agree with the CPU within 1 ulp)
+                *(device float *)(dst + i13*args.nb3 + i12*args.nb2 + i11*args.nb1 + row*sizeof(float)) =
+                    s > 0.0f ? (float) sum * precise::divide(ws, s) : 0.0f;
+            }
+        }
+    }
+}
+
+typedef decltype(kernel_mul_mv_i2_s_i8<1>) kernel_mul_mv_i2_s_i8_t;
+
