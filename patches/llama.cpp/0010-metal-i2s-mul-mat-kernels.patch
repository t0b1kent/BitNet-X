+            /*.nb2    =*/ nb2,
+            /*.nb3    =*/ nb3,
+            /*.ws_off =*/ (uint64_t) ne00*ne01/4,
+            /*.ne00   =*/ ne00,
+            /*.ne01   =*/ ne01,
+            /*.ne11   =*/ ne11,
+            /*.ne12   =*/ ne12,
+            /*.ncols  =*/ ncols,
